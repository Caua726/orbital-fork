{
  "name": "orbital",
  "version": "1.0.0",
  "description": "Jogo de estratégia espacial com renderização selecionável entre Pixi e Weydra.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:determinism": "node weydra-renderer/tests/determinism/runner.mjs",
    "test:engine-switch": "node tests/engine-switch-smoke.mjs",
    "test:fog-parity": "node tests/fog-parity-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:renderer": "cd weydra-renderer/adapters/wasm && wasm-pack build --target web --out-dir pkg && node ../../../scripts/sync-wasm.mjs",
    "build:renderer:release": "cd weydra-renderer/adapters/wasm && wasm-pack build --target web --release --out-dir pkg && node ../../../scripts/sync-wasm.mjs",
    "build:plugin": "cd weydra-renderer/vite-plugin-wgsl && tsc -p tsconfig.build.json",
    "sync:wasm": "node scripts/sync-wasm.mjs",
    "prebuild": "npm run build:renderer:release && npm run build:plugin"
  },
  "keywords": ["game", "strategy", "pixi", "webgpu", "webgl", "wasm"],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@weydra/renderer": "workspace:*",
    "@weydra/vite-plugin-wgsl": "workspace:*",
    "pixi.js": "^8.18.1-dev.8f42bb7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0-rc.0",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.59.1-alpha.4",
    "@typescript-eslint/parser": "^8.59.1-alpha.4",
    "@vitest/ui": "^5.0.0-beta.1",
    "eslint": "^10.0.0-rc.2",
    "happy-dom": "^20.9.0",
    "jiti": "^2.6.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.0-dev.20260416",
    "vite": "^8.0.10",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.0-beta.1"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "uuid": "^14.0.0"
  },
  "workspaces": [
    "weydra-renderer/ts-bridge",
    "weydra-renderer/vite-plugin-wgsl"
  ]
}
